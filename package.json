{
  "name": "simple-mcp-basics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ejemplo minimo y completo de MCP con TypeScript: server, client, tools, prompts y resources.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
